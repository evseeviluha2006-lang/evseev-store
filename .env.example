# Скопируй в .env.local и заполни реальными значениями.
# .env.local в git не попадает.

# --- ЮKassa ---
# Личный кабинет ЮKassa → Интеграция → Ключи API
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Чек по 54-ФЗ. Включай только если онлайн-касса реально настроена в ЮKassa,
# иначе платежи начнут падать. При скидке за комплект чек не отправляется.
YOOKASSA_SEND_RECEIPT=false
# Код ставки НДС: 1 — без НДС, 2 — 0%, 3 — 10%, 4 — 20% ...
YOOKASSA_VAT_CODE=1

# --- Telegram-уведомления ---
# Токен получить у @BotFather (/newbot или /token).
# ВАЖНО: старый токен нужно отозвать (/revoke) — он был в клиентском бандле.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Сайт ---
# Публичный адрес сайта. Используется для return_url после оплаты.
# Локально можно не задавать — возьмётся origin запроса.
NEXT_PUBLIC_SITE_URL=https://evseev.store
